  <script>
    (function(){
      var rooms=document.querySelectorAll('.room');
      rooms.forEach(function(room){
        var button=room.querySelector('button');
        var detail=room.querySelector('.room-detail');
        if(button.getAttribute('aria-expanded')==='true'){
          room.classList.add('open');
          detail.hidden=false;
        }
        button.addEventListener('click',function(){
          var isOpen=button.getAttribute('aria-expanded')==='true';
          rooms.forEach(function(otherRoom){
            var otherButton=otherRoom.querySelector('button');
            var otherDetail=otherRoom.querySelector('.room-detail');
            otherButton.setAttribute('aria-expanded','false');
            otherRoom.classList.remove('open');
            otherDetail.hidden=true;
          });
          if(!isOpen){
            detail.hidden=false;
            room.classList.add('open');
            button.setAttribute('aria-expanded','true');
          }
        });
      });
    }());
  </script>
